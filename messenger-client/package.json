{
  "name": "messenger-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "generate:proto:js": "pbjs -t static-module -w es6 proto/message.proto -o src/proto/message.js",
    "generate:proto:ts": "pbts src/proto/message.js -o src/proto/message.d.ts",
    "generate:proto": "npm run generate:proto:js && npm run generate:proto:ts"
  },
  "dependencies": {
    "@primevue/themes": "^4.5.4",
    "libsodium-wrappers": "^0.8.4",
    "pinia": "^3.0.4",
    "primeflex": "^4.0.0",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.5",
    "protobufjs": "^8.6.1",
    "vue": "^3.5.34",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^24.12.3",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/tsconfig": "^0.9.1",
    "protobufjs-cli": "^2.5.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vue-tsc": "^3.2.8"
  }
}
